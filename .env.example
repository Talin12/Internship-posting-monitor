# Copy to .env and fill in. Locally, main.py parses this file itself.
# In GitHub Actions these come from repository secrets, not this file.

# Telegram (notifications)
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here
TELEGRAM_CHAT_ID=987654321

# Hugging Face (resume matching). Free token: https://huggingface.co/settings/tokens
# If unset, matching turns off and all new postings are notified.
HF_API_TOKEN=hf_your_token_here

# Optional: resume text can live here instead of resume.txt.
# RESUME_TEXT="Talin Daga — full-stack developer, Python, Django..."
